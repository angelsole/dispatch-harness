# Copy to repos.local.sh (gitignored) to PIN per-repo pipeline settings.
#
# repos.conf.sh sources this file if it sits next to it (inside HARNESS_DIR)
# and calls repo_config_local() BEFORE auto-detection. Set any of the vars
# below for the repos you dispatch to; anything you leave blank is auto-detected
# from lockfiles + the remote's default branch.
#
# Two ways to add a repo:
#   1. Let the tool do it:  setup-repo.sh <repo-path> --write
#      It inspects the repo and inserts/updates a pinned arm inside the MANAGED
#      block below (idempotently — re-running a repo updates its arm in place).
#      Add --verify to prove INSTALL_CMD + GATE_CMD pass before it writes.
#   2. By hand: add a case arm anywhere in repo_config_local(). Hand-written arms
#      (like the examples at the bottom) are never touched by setup-repo.sh.
#
# Keys are the repo's directory name (basename). Worktrees are named
# "<repo>-<ticket-lowercased>", so match both "<repo>" and "<repo>-*".
#
# Variables (all optional):
#   BASE_BRANCH    base branch PRs target            (default: staging|main|master, detected)
#   INSTALL_CMD    install deps in a fresh worktree  (default: from lockfile)
#   GATE_CMD       the deterministic test gate       (default: from lockfile)
#   IMPLEMENTER_PROVIDER  which vendor the implementer bills to (anthropic | zai),
#                  overriding the machine's ambient default. Pin `anthropic` for
#                  a repo whose code is not approved for third-party model
#                  providers: the pin outranks an exported IMPLEMENTER_PROVIDER,
#                  so the dispatching machine's default cannot route that repo's
#                  code to a third party.
#   IMPLEMENTER_MODEL  a specific implementer model for this repo. Resolution is
#                  repo pin, then ambient env, then the provider's own default.
#   VISUAL_GATE_CMD  the visual profile's gate: render the app, check the frames,
#                  ask the critic. One of the two ways a repo opts into the
#                  profile — the other is carrying a .creative/ contract, which
#                  is enough on its own. Set it only to point at a gate of your
#                  own; the shipped one is
#                  "bash $HARNESS_DIR/profiles/visual/creative/visual-gate.sh".
#                  See profiles/visual/creative/README.md.
#   VISUAL_SCOPE_GLOBS  space-separated git pathspec globs naming the paths this
#                  repo's picture is made of. A branch that touches none of them
#                  skips the visual gate rather than grading a code-only diff
#                  against the reigning champion. Unset = the profile's defaults
#                  ("wall/** .creative/** assets/**"); a value REPLACES them, so
#                  list every path including .creative/**, e.g.
#                  VISUAL_SCOPE_GLOBS="src/render/** public/sprites/** .creative/**"
#   MCP_CONFIG     path to an .mcp.json for the worker (default: none; skipped if missing).
#                  For a repo with the visual profile this is the asset factories:
#                  MCP_CONFIG="$HARNESS_DIR/profiles/visual/creative/factory.mcp.json"
#                  gives the worker the PixelLab and Retro Diffusion MCP servers.
#                  Setting it also makes the profile source
#                  $HARNESS_DIR/factory.conf.sh (mode 600, the two API keys) into
#                  the IMPLEMENTER's process and nothing else — no gate, reviewer
#                  or PR stage ever sees a key. Missing conf = one SKIP line.
#   ENV_SUBDIRS    extra dirs besides "." to copy .env* into
#   DEV_CMD        dev server command for preview.sh
#   PREFLIGHT_CMD  env check run before the implementer (e.g. test DB up + migrated)
#   DEMO_DEV_CMD   dev server command for demo recording (MUST pin the port)
#   DEMO_PORT      port DEMO_DEV_CMD binds (storyboard origin + post-demo cleanup)
#   PREPROD        set to 1 for a repo that is not in production yet: both worker
#                  prompts then get the greenfield posture (remove obsolete paths
#                  instead of keeping compatibility layers, fallbacks or
#                  migrations; simplest thing that fully meets the requirements)

repo_config_local() {
  # $1 = absolute repo/worktree path, $2 = its basename
  local name="$2"
  case "$name" in

    # setup-repo.sh --write manages the arms between the two markers below. Each
    # arm is bounded by "# repo:<name>" / "# end:<name>"; re-running updates it in
    # place. Do not hand-edit inside the block — add hand-written arms outside it.
    # >>> setup-repo managed >>>
    # <<< setup-repo managed <<<

    # --- Hand-written examples (edit freely; setup-repo.sh never touches these) ---
    myapp|myapp-*)
      BASE_BRANCH=staging
      INSTALL_CMD="npm ci"
      GATE_CMD="npm run type-check && npm test"
      MCP_CONFIG="$HOME/code/myapp/.mcp.json"
      DEV_CMD="npm run dev"
      # Demo must run on the app's normal dev port: backend CORS allowlists
      # typically only cover the standard localhost origins.
      DEMO_DEV_CMD="npm run dev -- --port 5173 --strictPort"
      DEMO_PORT=5173
      ;;
    myapi|myapi-*)
      BASE_BRANCH=main
      INSTALL_CMD="npm ci"
      GATE_CMD="npm run lint && npm test"          # spins a Postgres test DB
      ENV_SUBDIRS="backend"
      # Verify the test DB is up + migrated before burning an implementer pass.
      # Copy examples/preflight-postgres.example.sh to HARNESS_DIR and adapt it.
      PREFLIGHT_CMD="${HARNESS_DIR:-$HOME/.claude/harness}/preflight-postgres.sh"
      DEV_CMD="npm run dev"
      ;;
    # Not shipped yet, so the workers get the opposite defaults from a mature
    # repo: no back-compat, no migrations, no compatibility layers.
    greenfield-app|greenfield-app-*)
      BASE_BRANCH=main
      INSTALL_CMD="npm ci"
      GATE_CMD="npm run type-check && npm test"
      PREPROD=1
      ;;
    my-python-svc|my-python-svc-*)
      BASE_BRANCH=main
      INSTALL_CMD="uv sync"
      GATE_CMD="uv run ruff check . && uv run pytest"
      DEV_CMD="./dev.sh start"
      ;;
    # A repo whose work is judged by eye. Carrying .creative/ is already enough
    # to activate the visual profile; this arm only adds the factories the
    # worker draws its assets with. The keys come from
    # $HARNESS_DIR/factory.conf.sh and reach the implementer only.
    my-game|my-game-*)
      BASE_BRANCH=main
      INSTALL_CMD="npm ci"
      GATE_CMD="npm test"
      MCP_CONFIG="${HARNESS_DIR:-$HOME/.claude/harness}/profiles/visual/creative/factory.mcp.json"
      ;;
  esac
}

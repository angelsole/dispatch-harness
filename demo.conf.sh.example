# Copy to demo.conf.sh (gitignored) to upload PR demo videos to object storage.
# Optional fallback for GitHub CLI versions without `gh pr edit --attach`.
# Capture always saves local media. A CLI supporting --attach uploads directly
# to GitHub; otherwise this config enables object-storage uploads.
#
# Requires rclone configured with a remote pointing at any S3-compatible bucket
# (Cloudflare R2, AWS S3, Backblaze B2, MinIO, ...). See `rclone config`.
#
#   R2_REMOTE  rclone "remote:bucket[/prefix]" the screenshots and video are copied to.
#   R2_PUBLIC  public base URL that serves that bucket (used in the PR embed).

R2_REMOTE=""      # e.g. "r2:my-dispatch-demos"
R2_PUBLIC=""      # e.g. "https://demos.example.com"
